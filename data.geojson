#!/usr/bin/env python3
"""
Clean a bryophilous-fungi GeoJSON file for use on a web map.

    python clean_records.py records_raw.geojson records.geojson

What it does
  1. Names: strips authority fragments ("Helotium Tode," -> "Helotium",
     "Lamprospora De" -> "Lamprospora", "Coniochaeta (Sacc.)" -> "Coniochaeta").
  2. Dates: keeps YYYY-MM-DD, YYYY-MM and YYYY; turns ranges ("2010/2021")
     and "Unknown Date" into null.
  3. Sources: "GBIF/Herbarium" -> "GBIF".
  4. Duplicates: removes records that are the same observation reported by
     both iNaturalist and GBIF (same date, nearby, compatible names).
     The iNaturalist copy is kept.
  5. Coordinates: rounded to 5 decimals (~1 m), invalid points dropped.
  6. Output is compact and sorted newest first.
"""
import json
import re
import sys
from collections import defaultdict

# Truncated epithets found in GBIF data that are not real names.
# Add more here if you spot them in the report.
BAD_EPITHETS = {"crec"}

DUP_DISTANCE_DEG = 0.002  # ~200 m
DATE_RE = re.compile(r"^\d{4}(-\d{2}(-\d{2})?)?$")


def clean_name(raw):
    """Genus + lowercase epithet(s). Stops at the first author-like token."""
    tokens = str(raw).replace(",", " ").split()
    if not tokens:
        return ""
    genus = tokens[0]
    if not genus[:1].isupper() or "(" in genus:
        return genus.strip("()")
    out = [genus]
    for t in tokens[1:]:
        if re.fullmatch(r"[a-z][a-z-]{3,}", t) and t not in BAD_EPITHETS:
            out.append(t)
        else:
            break  # author names, parentheses, truncated bits
    return " ".join(out)


def clean_date(raw):
    d = str(raw).strip() if raw is not None else ""
    return d if DATE_RE.match(d) else None


def clean_source(raw):
    return "iNaturalist" if str(raw).lower().startswith("inat") else "GBIF"


def names_compatible(a, b):
    ga, *ea = a.split()
    gb, *eb = b.split()
    if ga != gb:
        return False
    n = min(len(ea), len(eb))  # genus-only, or species vs subspecies, still match
    return ea[:n] == eb[:n]


def date_key(d):
    return d or ""


def main(src, dst):
    with open(src, encoding="utf-8") as f:
        data = json.load(f)

    stats = defaultdict(int)
    records = []
    for ft in data["features"]:
        stats["input"] += 1
        try:
            lon, lat = ft["geometry"]["coordinates"][:2]
            lon, lat = float(lon), float(lat)
        except (KeyError, TypeError, ValueError):
            stats["dropped_bad_geometry"] += 1
            continue
        if not (-90 <= lat <= 90 and -180 <= lon <= 180):
            stats["dropped_out_of_range"] += 1
            continue
        p = ft.get("properties", {})
        name = clean_name(p.get("s", ""))
        if not name:
            stats["dropped_no_name"] += 1
            continue
        if name != p.get("s"):
            stats["names_cleaned"] += 1
        d = clean_date(p.get("d"))
        if d is None:
            stats["dates_nulled"] += 1
        records.append({
            "lon": lon, "lat": lat, "s": name, "d": d,
            "p": clean_source(p.get("p")), "u": p.get("u", ""),
        })

    # Prefer iNaturalist copies, then more specific names.
    records.sort(key=lambda r: (r["p"] != "iNaturalist", -len(r["s"])))

    kept = []
    buckets = defaultdict(list)  # date -> kept records
    for r in records:
        dup = None
        if r["d"]:
            for k in buckets[r["d"]]:
                if (abs(k["lat"] - r["lat"]) <= DUP_DISTANCE_DEG
                        and abs(k["lon"] - r["lon"]) <= DUP_DISTANCE_DEG
                        and names_compatible(k["s"], r["s"])):
                    dup = k
                    break
        if dup:
            stats["duplicates_removed"] += 1
            # If the dropped copy has a more specific name, keep that name.
            if len(r["s"]) > len(dup["s"]) and names_compatible(dup["s"], r["s"]):
                dup["s"] = r["s"]
            continue
        kept.append(r)
        if r["d"]:
            buckets[r["d"]].append(r)

    kept.sort(key=lambda r: date_key(r["d"]), reverse=True)

    features = [{
        "type": "Feature",
        "geometry": {"type": "Point",
                     "coordinates": [round(r["lon"], 5), round(r["lat"], 5)]},
        "properties": {"s": r["s"], "d": r["d"], "p": r["p"], "u": r["u"]},
    } for r in kept]

    with open(dst, "w", encoding="utf-8") as f:
        json.dump({"type": "FeatureCollection", "features": features},
                  f, ensure_ascii=False, separators=(",", ":"))

    print(f"Wrote {len(features)} features to {dst}")
    for k, v in stats.items():
        print(f"  {k}: {v}")

    # Things worth a manual look
    old_inat = [r for r in kept if r["p"] == "iNaturalist" and r["d"] and r["d"] < "2000"]
    if old_inat:
        print("\nCheck these iNaturalist records (date before 2000):")
        for r in old_inat:
            print(f"  {r['d']}  {r['s']}  {r['u']}")
    print("\nNames in output:", len({r['s'] for r in kept}))


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    main(sys.argv[1], sys.argv[2])
